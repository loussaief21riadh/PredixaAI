# PredixaAI staging configuration.
# Copy this file to .env.staging.
# Replace every CHANGE_ME value.
# Never commit .env.staging.

APP_ENV=staging
DEBUG=false
APP_VERSION=7.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg://predixa:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/predixa
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
SQL_ECHO=false

# Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

CORS_ALLOWED_ORIGINS=https://staging.predixaai.com
TRUSTED_HOSTS=api-staging.predixaai.com,localhost,127.0.0.1

POSTGRES_DB=predixa
POSTGRES_USER=predixa
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
